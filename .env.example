# Copie este arquivo para .env e ajuste as variáveis conforme necessário

# Chave da API OpenAI (opcional, apenas para revisão final)
OPENAI_API_KEY=

# Modelos e ajustes do faster-whisper (opcionais)
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE=int8
CHUNK_MINUTES=10
CHUNK_WORKERS=2
WHISPER_NUM_WORKERS=2
