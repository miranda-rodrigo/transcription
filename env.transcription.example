# Exemplo de arquivo .env para o processador de transcrição
# Copie este arquivo como '.env' e preencha suas configurações

# OpenAI API Key (necessária para refinamento com IA)
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sua_chave_openai_aqui

# Configurações opcionais (descomente se necessário)

# Modelo OpenAI a usar (padrão: gpt-4o)
# OPENAI_MODEL=gpt-4o

# Timeout para requisições OpenAI em segundos (padrão: 60)
# OPENAI_TIMEOUT=60

# Tamanho máximo de chunk para IA em caracteres (padrão: 15000)
# MAX_CHUNK_SIZE=15000